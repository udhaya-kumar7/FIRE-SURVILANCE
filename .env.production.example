# ==========================================================
# FireWatch AI — Production Environment Variables
# Copy this file to .env and fill in your real values
# ==========================================================

# --------------------------------------------------------
# BACKEND (backend/.env)
# --------------------------------------------------------
PORT=5000

# MongoDB: Use MongoDB Atlas for cloud hosting
# Format: mongodb+srv://user:password@cluster.mongodb.net/fire-surveillance
MONGODB_URI=mongodb://localhost:27017/fire-surveillance

# JWT Secret: MUST be a long random string for production!
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# URLs: Set to your actual domain
YOLO_SERVICE_URL=http://localhost:8000
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

NODE_ENV=production

# Fire detection confidence thresholds
LIVE_FIRE_MIN_CONFIDENCE=0.55
UPLOAD_FIRE_MIN_CONFIDENCE=0.65
LIVE_FIRE_MIN_BOX_AREA=1200
UPLOAD_FIRE_MIN_BOX_AREA=2500

# Email alerts (optional — get App Password from Google Account settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_google_app_password

# --------------------------------------------------------
# FRONTEND (frontend/.env)
# --------------------------------------------------------
# Replace with your actual hosted backend domain:
REACT_APP_API_URL=https://yourdomain.com/api
REACT_APP_SOCKET_URL=https://yourdomain.com
GENERATE_SOURCEMAP=false

# --------------------------------------------------------
# YOLO SERVICE (yolo-service/.env)
# --------------------------------------------------------
# Get free Roboflow API key from https://roboflow.com
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL=fire-detection-hy9la/1

# Optional: HuggingFace inference
HUGGINGFACE_API_KEY=

BACKEND_URL=https://yourdomain.com
MODEL_INFERENCE_CONFIDENCE=0.45
MIN_DETECTION_BOX_AREA=800

# --------------------------------------------------------
# DOCKER COMPOSE (set these as shell env vars before docker-compose up)
# --------------------------------------------------------
# export JWT_SECRET="your_strong_secret_here"
# export FRONTEND_URL="https://yourdomain.com"
# export REACT_APP_API_URL="https://yourdomain.com/api"
# export REACT_APP_SOCKET_URL="https://yourdomain.com"
