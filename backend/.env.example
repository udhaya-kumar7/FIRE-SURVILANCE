PORT=5000
MONGODB_URI=mongodb://localhost:27017/fire-surveillance
JWT_SECRET=your-super-secret-jwt-key-change-in-production
YOLO_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Detection filtering (helps reduce false positives)
LIVE_FIRE_MIN_CONFIDENCE=0.55
UPLOAD_FIRE_MIN_CONFIDENCE=0.65
LIVE_FIRE_MIN_BOX_AREA=1200
UPLOAD_FIRE_MIN_BOX_AREA=2500

# Email alerts configuration (Optional, e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_google_app_password

