# Fire Detection API Configuration
# =================================
# You need at least ONE of these APIs configured for real fire detection.
# Both have FREE tiers!

# Option 1: Roboflow API (RECOMMENDED - has bounding boxes)
# ---------------------------------------------------------
# 1. Go to https://roboflow.com and create a free account
# 2. Get your API key from Settings > API Keys
# 3. Set it below:
ROBOFLOW_API_KEY=your_api_key_here
ROBOFLOW_MODEL=fire-detection-hy9la/1

# Option 2: HuggingFace API (Classification only)
# -----------------------------------------------
# 1. Go to https://huggingface.co and create a free account
# 2. Go to Settings > Access Tokens > Create new token
# 3. Set it below:
HUGGINGFACE_API_KEY=your_api_key_here

# Backend URL
BACKEND_URL=http://localhost:5000

# Benchmark dataset root directory (contains fire/ and no_fire/ subfolders)
BENCHMARK_DIR=./benchmark

# Inference filtering for trained models
# Increase confidence to reduce false positives.
MODEL_INFERENCE_CONFIDENCE=0.5

# Ignore tiny predicted boxes (width * height in pixels).
MIN_DETECTION_BOX_AREA=900
